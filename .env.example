# คัดลอกไฟล์นี้เป็น .env แล้วใส่รหัสที่ตั้งตอนรัน db/00_setup.sql (ไฟล์ .env ไม่ขึ้น git)
# รหัสมีอักขระพิเศษ (@ : / ? # %) ต้องเข้ารหัส URL ก่อน เช่น @ → %40

# ฐานข้อมูลจริงของแอป — ไม่ตั้ง = แอปใช้ข้อมูลเดโมในหน่วยความจำ (หายเมื่อรีสตาร์ท)
# พอร์ตต้องตรงกับตัวที่รัน db/00_setup.sql ไว้: PostgreSQL 17 = 5433, PostgreSQL 18 = 5432
DATABASE_URL=postgresql://clockin:CHANGE_ME@localhost:5433/clockin

# ฐานข้อมูลสำหรับชุดทดสอบ — ล้างข้อมูลทุกครั้งที่รันเทส ห้ามชี้ไปที่ฐานข้อมูลจริง
TEST_DATABASE_URL=postgresql://clockin:CHANGE_ME@localhost:5433/clockin_test
